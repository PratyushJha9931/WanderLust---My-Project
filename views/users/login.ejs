<% layout("/layouts/boilerplate") %>

<div class="row justify-content-center align-items-center py-5">
  <div class="col-md-6 col-lg-5">
    <div class="card auth-card border-0 shadow-lg rounded-4 p-4 p-md-5">
      <div class="text-center mb-4">
        <div class="auth-icon-wrapper mb-2">
          <i class="fa-solid fa-compass text-danger display-5"></i>
        </div>
        <h2 class="fw-bold mb-1">Welcome Back</h2>
        <p class="text-muted small">Log in to WanderLust to plan your next journey</p>
      </div>

      <form action="/login" method="POST" class="needs-validation" novalidate>
        <div class="mb-3">
          <label for="username" class="form-label fw-semibold">Username</label>
          <div class="input-group">
            <span class="input-group-text rounded-start-3"><i class="fa-solid fa-user text-muted"></i></span>
            <input 
              name="username" 
              id="username" 
              type="text" 
              class="form-control rounded-end-3" 
              placeholder="Enter your username" 
              required
            />
          </div>
          <div class="invalid-feedback">Please enter your username.</div>
        </div>

        <div class="mb-4">
          <label for="password" class="form-label fw-semibold">Password</label>
          <div class="input-group">
            <span class="input-group-text rounded-start-3"><i class="fa-solid fa-lock text-muted"></i></span>
            <input 
              name="password" 
              id="password" 
              type="password" 
              class="form-control" 
              placeholder="Enter your password" 
              required
            />
            <button class="btn btn-outline-secondary rounded-end-3 toggle-password-btn" type="button" data-target="#password">
              <i class="fa-regular fa-eye"></i>
            </button>
          </div>
          <div class="invalid-feedback">Please enter your password.</div>
        </div>

        <div class="d-grid mb-3">
          <button class="btn btn-danger btn-lg rounded-pill fw-bold" type="submit">
            Log In
          </button>
        </div>

        <div class="text-center text-muted small">
          Don't have an account yet? 
          <a href="/signup" class="text-danger fw-semibold text-decoration-none ms-1">Create an account</a>
        </div>
      </form>
    </div>
  </div>
</div>