<% layout("/layouts/boilerplate") %>

<div class="listing-detail-page py-3">
  <!-- Top Breadcrumb & Title Header -->
  <div class="detail-header mb-3">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
      <div>
        <span class="badge bg-danger-subtle text-danger mb-2 px-3 py-1 rounded-pill fw-semibold">
          <i class="fa-solid fa-tag me-1"></i> <%= listing.category || 'Featured Stay' %>
        </span>
        <h1 class="listing-main-title fw-bold"><%= listing.title %></h1>
        <p class="listing-main-location text-muted mb-0">
          <i class="fa-solid fa-location-dot text-danger me-1"></i>
          <%= listing.location %>, <%= listing.country %>
        </p>
      </div>

      <!-- Action Buttons (Wishlist & Share) -->
      <div class="d-flex gap-2">
        <button class="btn btn-outline-secondary rounded-pill px-3 btn-sm" id="btn-share-listing">
          <i class="fa-solid fa-arrow-up-from-bracket me-1"></i> Share
        </button>
        <button class="btn btn-outline-danger rounded-pill px-3 btn-sm btn-wishlist-detail" id="btn-save-listing">
          <i class="fa-regular fa-heart me-1"></i> Save
        </button>
      </div>
    </div>
  </div>

  <!-- Hero Image Gallery Container -->
  <div class="detail-gallery mb-4">
    <div class="gallery-hero-wrapper">
      <img src="<%= listing.image.url %>" class="gallery-hero-img" alt="<%= listing.title %>" />
      <div class="gallery-overlay-badge">
        <i class="fa-solid fa-camera me-1"></i> Verified WanderLust Stay
      </div>
    </div>
  </div>

  <!-- Main Content Layout (2-Column Desktop Grid) -->
  <div class="row g-4">
    <!-- Left Column: Details, AI Insights, Amenities, Reviews, Map -->
    <div class="col-lg-8">
      <!-- Host Information Card -->
      <div class="host-info-card p-3 rounded-4 mb-4 shadow-sm border">
        <div class="d-flex align-items-center justify-content-between">
          <div class="d-flex align-items-center">
            <div class="host-avatar-circle me-3">
              <%= (listing.owner && listing.owner.username ? listing.owner.username.charAt(0).toUpperCase() : 'H') %>
            </div>
            <div>
              <h5 class="fw-bold mb-0">
                Hosted by <%= listing.owner && listing.owner.username ? listing.owner.username : 'WanderLust Superhost' %>
              </h5>
              <div class="text-muted small">
                <i class="fa-solid fa-medal text-warning me-1"></i> Superhost • 100% response rate
              </div>
            </div>
          </div>
          <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill">
            <i class="fa-solid fa-shield-halved me-1"></i> Verified Identity
          </span>
        </div>
      </div>

      <!-- Property Description -->
      <div class="property-description mb-4">
        <h4 class="fw-bold mb-3">About this space</h4>
        <p class="description-text text-secondary lh-lg mb-0">
          <%= listing.description %>
        </p>
      </div>

      <hr class="my-4" />

      <!-- ✨ AI Review Sentiment & Stay Insights Box ✨ -->
      <div class="ai-insights-card p-4 rounded-4 mb-4 shadow-sm" id="ai-insights-box" data-listing-id="<%= listing._id %>">
        <div class="d-flex align-items-center justify-content-between mb-3">
          <div class="d-flex align-items-center">
            <div class="ai-sparkle-icon me-2">
              <i class="fa-solid fa-wand-magic-sparkles"></i>
            </div>
            <h4 class="fw-bold mb-0">AI Stay Insights & Guest Sentiment</h4>
          </div>
          <span class="badge ai-pill-badge px-3 py-1 rounded-pill">Gemini Powered</span>
        </div>

        <div class="ai-insights-body">
          <div class="d-flex align-items-center mb-3">
            <div class="sentiment-score-badge me-3">
              <span class="score-number" id="ai-score-num">95%</span>
              <span class="score-label">Positive Sentiment</span>
            </div>
            <div class="sentiment-summary text-secondary small" id="ai-summary-text">
              Analyzing guest feedback and neighborhood amenities for <b><%= listing.title %></b>...
            </div>
          </div>

          <div class="ai-highlights-tags" id="ai-pros-container">
            <span class="ai-tag tag-pro"><i class="fa-solid fa-circle-check me-1"></i> Scenic Views</span>
            <span class="ai-tag tag-pro"><i class="fa-solid fa-circle-check me-1"></i> Sparkling Cleanliness</span>
            <span class="ai-tag tag-pro"><i class="fa-solid fa-circle-check me-1"></i> Warm Hospitality</span>
            <span class="ai-tag tag-con"><i class="fa-solid fa-clock me-1"></i> High Seasonal Demand</span>
          </div>
        </div>
      </div>

      <hr class="my-4" />

      <!-- Curated Amenities Grid -->
      <div class="amenities-section mb-4">
        <h4 class="fw-bold mb-3">What this place offers</h4>
        <div class="row row-cols-2 row-cols-md-3 g-3">
          <div class="col amenity-item d-flex align-items-center">
            <i class="fa-solid fa-wifi amenity-icon me-2"></i>
            <span>High-Speed Wi-Fi</span>
          </div>
          <div class="col amenity-item d-flex align-items-center">
            <i class="fa-solid fa-square-parking amenity-icon me-2"></i>
            <span>Free Parking</span>
          </div>
          <div class="col amenity-item d-flex align-items-center">
            <i class="fa-solid fa-snowflake amenity-icon me-2"></i>
            <span>Air Conditioning</span>
          </div>
          <div class="col amenity-item d-flex align-items-center">
            <i class="fa-solid fa-utensils amenity-icon me-2"></i>
            <span>Fully Equipped Kitchen</span>
          </div>
          <div class="col amenity-item d-flex align-items-center">
            <i class="fa-solid fa-person-swimming amenity-icon me-2"></i>
            <span>Pool / Water Access</span>
          </div>
          <div class="col amenity-item d-flex align-items-center">
            <i class="fa-solid fa-shield-virus amenity-icon me-2"></i>
            <span>Carbon Monoxide Alarm</span>
          </div>
        </div>
      </div>

      <hr class="my-4" />

      <!-- Reviews Section -->
      <div class="reviews-section mb-4">
        <div class="d-flex align-items-center justify-content-between mb-4">
          <h4 class="fw-bold mb-0">
            <i class="fa-solid fa-star text-warning me-1"></i>
            <%= listing.reviews.length > 0 ? `${(4.8 + (Math.random()*0.15)).toFixed(2)} • ${listing.reviews.length} Review(s)` : 'No Reviews Yet' %>
          </h4>
        </div>

        <!-- Leave a Review Form (if logged in) -->
        <% if (currUser) { %>
          <div class="card review-form-card p-3 rounded-4 mb-4 shadow-sm border">
            <h5 class="fw-bold mb-3">Share your experience</h5>
            <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
              <div class="mb-3">
                <label class="form-label fw-semibold">Rating</label>
                <fieldset class="starability-slot">
                  <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                  <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                  <label for="first-rate1" title="Terrible">1 star</label>
                  <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                  <label for="first-rate2" title="Not good">2 stars</label>
                  <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                  <label for="first-rate3" title="Average">3 stars</label>
                  <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                  <label for="first-rate4" title="Very good">4 stars</label>
                  <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                  <label for="first-rate5" title="Amazing">5 stars</label>
                </fieldset>
              </div>

              <div class="mb-3">
                <label for="comment" class="form-label fw-semibold">Your Comment</label>
                <textarea 
                  name="review[comment]" 
                  id="comment" 
                  rows="3" 
                  class="form-control rounded-3" 
                  placeholder="What made your stay special? How was the host?" 
                  required
                ></textarea>
                <div class="invalid-feedback">Please write a review comment.</div>
              </div>

              <button class="btn btn-danger rounded-pill px-4" type="submit">
                Submit Review
              </button>
            </form>
          </div>
        <% } %>

        <!-- Existing Reviews Grid -->
        <div class="row row-cols-1 row-cols-md-2 g-3">
          <% for (let review of listing.reviews) { %>
            <div class="col">
              <div class="card review-card h-100 p-3 rounded-4 shadow-sm border">
                <div class="card-body p-0">
                  <div class="d-flex align-items-center justify-content-between mb-2">
                    <div class="d-flex align-items-center">
                      <div class="review-avatar-circle me-2">
                        <%= review.author && review.author.username ? review.author.username.charAt(0).toUpperCase() : 'G' %>
                      </div>
                      <div>
                        <h6 class="fw-bold mb-0">@<%= review.author && review.author.username ? review.author.username : 'Guest' %></h6>
                        <small class="text-muted">Verified Stay</small>
                      </div>
                    </div>
                    <p class="starability-result mb-0" data-rating="<%= review.rating %>"></p>
                  </div>
                  <p class="review-text text-secondary mb-3"><%= review.comment %></p>
                  
                  <% if (currUser && review.author && review.author._id && currUser._id && review.author._id.equals(currUser._id)) { %>
                    <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                      <button class="btn btn-sm btn-outline-danger rounded-pill px-3">
                        <i class="fa-solid fa-trash me-1"></i> Delete
                      </button>
                    </form>
                  <% } %>
                </div>
              </div>
            </div>
          <% } %>
        </div>
      </div>

      <hr class="my-4" />

      <!-- Interactive Map Section -->
      <div class="map-section mb-4" 
           id="map-container"
           data-coordinates="<%- JSON.stringify(listing.geometry && listing.geometry.coordinates ? listing.geometry.coordinates : [77.4126, 23.2599]) %>"
           data-title="<%= listing.title %>"
           data-location="<%= listing.location %>, <%= listing.country %>">
        <h4 class="fw-bold mb-2">Where you'll be</h4>
        <p class="text-muted mb-3"><i class="fa-solid fa-map-pin me-1 text-danger"></i> <%= listing.location %>, <%= listing.country %></p>
        <div id="map" class="shadow-sm rounded-4 border" style="height: 380px; width: 100%;"></div>
      </div>
    </div>

    <!-- Right Column: Sticky Booking & WanderBot Assistant Card -->
    <div class="col-lg-4">
      <div class="sticky-booking-wrapper sticky-top" style="top: 6rem; z-index: 10;">
        <div class="card booking-card p-4 rounded-4 shadow-lg border">
          <!-- Price Header -->
          <div class="d-flex justify-content-between align-items-baseline mb-3">
            <div>
              <span class="fs-3 fw-bold text-dark-emphasis">₹<%= listing.price.toLocaleString("en-IN") %></span>
              <span class="text-muted"> / night</span>
            </div>
            <div class="small text-muted">
              <i class="fa-solid fa-star text-warning"></i> 4.9 (Verified)
            </div>
          </div>

          <!-- Night Selector & Price Breakdown Simulation -->
          <div class="booking-inputs p-2 rounded-3 border mb-3 bg-body-tertiary">
            <div class="row g-2">
              <div class="col-6 border-end">
                <label class="form-label small fw-bold mb-0 text-uppercase">Check-In</label>
                <div class="text-muted small">Add date</div>
              </div>
              <div class="col-6">
                <label class="form-label small fw-bold mb-0 text-uppercase">Check-Out</label>
                <div class="text-muted small">Add date</div>
              </div>
            </div>
          </div>

          <!-- Total Calculation preview -->
          <div class="price-breakdown mb-3">
            <div class="d-flex justify-content-between text-muted small mb-1">
              <span>₹<%= listing.price.toLocaleString("en-IN") %> x 3 nights</span>
              <span>₹<%= (listing.price * 3).toLocaleString("en-IN") %></span>
            </div>
            <div class="d-flex justify-content-between text-muted small mb-1">
              <span>WanderLust Service Fee</span>
              <span>₹<%= Math.round(listing.price * 0.05).toLocaleString("en-IN") %></span>
            </div>
            <div class="d-flex justify-content-between text-muted small mb-2">
              <span>Taxes & GST (18%)</span>
              <span>₹<%= Math.round(listing.price * 3 * 0.18).toLocaleString("en-IN") %></span>
            </div>
            <hr class="my-2" />
            <div class="d-flex justify-content-between fw-bold fs-5">
              <span>Total before taxes</span>
              <span>₹<%= Math.round((listing.price * 3 * 1.18) + (listing.price * 0.05)).toLocaleString("en-IN") %></span>
            </div>
          </div>

          <!-- Primary Reservation CTA -->
          <button class="btn btn-danger btn-lg w-100 rounded-pill fw-bold mb-2 btn-reserve-glow" id="btn-reserve-stay">
            Reserve Stay
          </button>
          <div class="text-center text-muted small mb-3">
            You won't be charged yet
          </div>

          <hr class="my-2" />

          <!-- WanderBot AI Assistant Integration Button -->
          <button class="btn btn-ai-listing-ask w-100 rounded-pill d-flex align-items-center justify-content-center py-2" id="ask-ai-about-this-stay" data-listing-title="<%= listing.title %>" data-listing-id="<%= listing._id %>">
            <i class="fa-solid fa-wand-magic-sparkles me-2"></i>
            <span>Ask WanderBot about this stay</span>
          </button>

          <!-- Host Edit/Delete Controls (if authorized) -->
          <% if (currUser && listing.owner && listing.owner._id && listing.owner._id.equals(currUser._id)) { %>
            <hr class="my-3" />
            <div class="d-flex gap-2">
              <a href="/listings/<%= listing._id %>/edit" class="btn btn-outline-dark rounded-pill flex-fill">
                <i class="fa-solid fa-pen-to-square me-1"></i> Edit
              </a>
              <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="flex-fill" onsubmit="return confirm('Are you sure you want to delete this listing?');">
                <button class="btn btn-danger rounded-pill w-100">
                  <i class="fa-solid fa-trash me-1"></i> Delete
                </button>
              </form>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- MapTiler SDK CDN -->
<link href="https://cdn.maptiler.com/maptiler-sdk-js/v4.0.2/maptiler-sdk.css" rel="stylesheet" />
<script src="https://cdn.maptiler.com/maptiler-sdk-js/v4.0.2/maptiler-sdk.umd.min.js"></script>

<script>
  // Map initialization
  document.addEventListener("DOMContentLoaded", () => {
    const mapContainer = document.getElementById("map-container");
    if (!mapContainer) return;

    let coordinates = [77.4126, 23.2599];
    try {
      coordinates = JSON.parse(mapContainer.dataset.coordinates);
    } catch(e) {}

    const listingTitle = mapContainer.dataset.title;
    const listingLocation = mapContainer.dataset.location;
    const maptilerApiKey = "<%= mapToken %>";

    if (window.maptilersdk && maptilerApiKey) {
      maptilersdk.config.apiKey = maptilerApiKey;
      const map = new maptilersdk.Map({
        container: 'map',
        style: maptilersdk.MapStyle.STREETS,
        center: coordinates,
        zoom: 13
      });

      const popup = new maptilersdk.Popup({ offset: 25, closeButton: false })
        .setHTML(`
          <div style="padding: 6px; font-family: 'Plus Jakarta Sans', sans-serif;">
            <b style="color: #ff385c;">${listingTitle}</b><br>
            <small style="color: #64748b;">${listingLocation}</small>
          </div>
        `);

      new maptilersdk.Marker({ color: "#ff385c" })
        .setLngLat(coordinates)
        .setPopup(popup)
        .addTo(map);
    }
  });
</script>