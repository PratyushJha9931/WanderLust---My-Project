<% layout("/layouts/boilerplate") %>

<div class="row justify-content-center py-4">
  <div class="col-lg-8 col-md-10">
    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-4">
      <div>
        <h2 class="fw-bold mb-1">Edit Listing</h2>
        <p class="text-muted mb-0">Update information for <b><%= listing.title %></b></p>
      </div>
      <a href="/listings/<%= listing._id %>" class="btn btn-outline-secondary rounded-pill px-3">
        <i class="fa-solid fa-arrow-left me-1"></i> Cancel
      </a>
    </div>

    <!-- AI Polish Assistant Banner -->
    <div class="card ai-magic-card mb-4 border-0 shadow-sm p-4 rounded-4">
      <div class="d-flex align-items-center justify-content-between mb-2">
        <div class="d-flex align-items-center">
          <div class="ai-sparkle-icon me-2">
            <i class="fa-solid fa-wand-magic-sparkles text-primary"></i>
          </div>
          <h5 class="fw-bold mb-0">AI Copy Re-writer & Optimizer</h5>
        </div>
        <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-1">Instant Rewrite</span>
      </div>
      <p class="text-muted small mb-3">
        Want to polish this listing's description to attract more bookings? Click below to let AI enhance your listing copy!
      </p>
      <div class="d-flex gap-2">
        <input 
          type="text" 
          id="ai-prompt-input" 
          class="form-control rounded-pill px-3" 
          placeholder="Optional: Add new highlight (e.g. 'Added private jacuzzi and bonfire area')"
        />
        <button class="btn btn-primary rounded-pill px-4 fw-semibold text-nowrap" id="btn-ai-generate" type="button">
          <i class="fa-solid fa-sparkles me-1"></i> AI Polish
        </button>
      </div>
      <div id="ai-gen-status" class="small text-muted mt-2 d-none">
        <i class="fa-solid fa-circle-notch fa-spin text-primary me-1"></i> Enhancing copy with AI...
      </div>
    </div>

    <!-- Edit Form -->
    <div class="card p-4 p-md-5 rounded-4 shadow-sm border">
      <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">
        <!-- Title Input -->
        <div class="mb-3">
          <label for="title" class="form-label fw-semibold">Title</label>
          <input 
            name="listing[title]" 
            id="title" 
            value="<%= listing.title %>" 
            type="text" 
            class="form-control form-control-lg rounded-3" 
            required
          />
          <div class="invalid-feedback">Please enter a title.</div>
        </div>

        <!-- Description Input -->
        <div class="mb-3">
          <label for="description" class="form-label fw-semibold">Description</label>
          <textarea 
            name="listing[description]" 
            id="description" 
            rows="5" 
            class="form-control rounded-3" 
            required
          ><%= listing.description %></textarea>
          <div class="invalid-feedback">Please enter a description.</div>
        </div>

        <!-- Current Image & Upload New Image -->
        <div class="mb-4">
          <label class="form-label fw-semibold">Current Cover Image</label>
          <div class="mb-2">
            <img 
              src="<%= originalImageUrl %>" 
              class="rounded-3 shadow-sm" 
              style="max-height: 200px; width: auto; object-fit: cover;" 
              alt="Current Cover"
            />
          </div>
          <label for="image" class="form-label fw-semibold">Upload New Image (Optional)</label>
          <input 
            name="listing[image]" 
            id="image" 
            type="file" 
            class="form-control rounded-3" 
            accept="image/*"
          />
        </div>

        <!-- Price & Country Row -->
        <div class="row g-3 mb-3">
          <div class="col-md-5">
            <label for="price" class="form-label fw-semibold">Price per Night (₹)</label>
            <div class="input-group">
              <span class="input-group-text rounded-start-3">₹</span>
              <input 
                name="listing[price]" 
                id="price" 
                value="<%= listing.price %>" 
                type="number" 
                min="0"
                class="form-control rounded-end-3" 
                required
              />
            </div>
            <div class="invalid-feedback">Please enter a valid price.</div>
          </div>

          <div class="col-md-7">
            <label for="country" class="form-label fw-semibold">Country</label>
            <input 
              name="listing[country]" 
              id="country" 
              value="<%= listing.country %>" 
              type="text" 
              class="form-control rounded-3" 
              required
            />
            <div class="invalid-feedback">Country is required.</div>
          </div>
        </div>

        <!-- Location City Input -->
        <div class="mb-3">
          <label for="location" class="form-label fw-semibold">Location / City</label>
          <input 
            name="listing[location]" 
            id="location" 
            value="<%= listing.location %>" 
            type="text" 
            class="form-control rounded-3" 
            required
          />
          <div class="invalid-feedback">Location is required.</div>
        </div>

        <!-- Category Dropdown -->
        <div class="mb-4">
          <label for="category" class="form-label fw-semibold">Category</label>
          <select name="listing[category]" id="category" class="form-select rounded-3" required>
            <option value="Trending" <%= listing.category === 'Trending' ? 'selected' : '' %>>Trending 🔥</option>
            <option value="Rooms" <%= listing.category === 'Rooms' ? 'selected' : '' %>>Rooms 🛏️</option>
            <option value="Iconic Cities" <%= listing.category === 'Iconic Cities' ? 'selected' : '' %>>Iconic Cities 🏙️</option>
            <option value="Mountains" <%= listing.category === 'Mountains' ? 'selected' : '' %>>Mountains 🏔️</option>
            <option value="Castles" <%= listing.category === 'Castles' ? 'selected' : '' %>>Castles 🏰</option>
            <option value="Amazing Pools" <%= listing.category === 'Amazing Pools' ? 'selected' : '' %>>Amazing Pools 🏊</option>
            <option value="Camping" <%= listing.category === 'Camping' ? 'selected' : '' %>>Camping ⛺</option>
            <option value="Farms" <%= listing.category === 'Farms' ? 'selected' : '' %>>Farms 🚜</option>
            <option value="Arctic" <%= listing.category === 'Arctic' ? 'selected' : '' %>>Arctic ❄️</option>
          </select>
        </div>

        <!-- Submit Button -->
        <div class="d-grid">
          <button class="btn btn-danger btn-lg rounded-pill fw-bold" type="submit">
            Save Changes
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
